includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    paths:
        - src
        - config
    tmpDir: tmp/phpstan
    # The package's own config/ directory is where env() belongs.
    configDirectories:
        - config
